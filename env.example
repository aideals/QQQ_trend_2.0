# Alpaca Paper Trading credentials
ALPACA_API_KEY=YOUR_PAPER_API_KEY
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET_KEY

# report | paper | live
RUN_MODE=paper

# 1 = run Walk Forward + Monte Carlo before daily decision
# 0 = daily server mode only
RUN_BACKTEST=0

# Must remain 0 unless you intentionally enable real trading
ALLOW_LIVE_TRADING=0
